NUXT_SESSION_PASSWORD=5ac9b0be53b44b32942ac4ca131b1811

# --- Database Configuration ---
# Set dialect to 'postgresql' or 'sqlite'
# DB_DIALECT="postgresql"
DB_DIALECT="sqlite"

# SQLite connection string (local file or Turso URL)
DATABASE_URL="file:./.data/db/sqlite.db"
 
PORT=5400

# VPS/Nginx: trust X-Real-IP, X-Forwarded-For and X-Geo-* only when Node is not publicly reachable.
APAY_TRUST_PROXY=false
# Optional absolute path; defaults to resource/GeoLite2-City.mmdb.
# APAY_GEOLITE2_CITY_DB=/var/lib/GeoIP/GeoLite2-City.mmdb
