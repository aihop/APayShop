{
  "schemaVersion": 1,
  "id": "theme",
  "name": "Theme Catalog",
  "description": "Manage downloadable storefront theme packages published in the Shoply marketplace.",
  "version": "1.0.0",
  "defaultEnabled": false,
  "database": {
    "migrations": [
      {
        "id": "0001-create-catalog",
        "sqlite": "sqlite/0001-create-catalog.sql",
        "postgresql": "postgresql/0001-create-catalog.sql",
        "mysql": "mysql/0001-create-catalog.sql"
      }
    ]
  },
  "capabilities": [
    {
      "key": "catalog",
      "label": "Theme Catalog",
      "labelZh": "主题管理",
      "editable": true
    }
