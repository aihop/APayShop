{
  "name": "apay",
  "version": "1.0.1",
  "main": "index.js",
  "scripts": {
    "prebuild": "npm run check:qingpu-listing-publish-facts && npm run check:qingpu-employee-access-gate && npm run check:qingpu-quota-gate",
    "build": "node scripts/run-nuxt-build.mjs",
    "build-pg": "unset DATABASE_URL && DB_DIALECT=postgresql yarn build",
    "predev": "node scripts/reset-theme-manifest.mjs && node scripts/generate-theme-build.mjs --all",
    "dev": "ulimit -n 65536; NODE_OPTIONS='--max-old-space-size=32768' nuxt dev --host 127.0.0.1 --env-file=.env --port 5400",
    "generate": "nuxt generate",
    "preview": "nuxt preview --port 5400",
    "postinstall": "node scripts/generate-theme-build.mjs --all && nuxt prepare",
    "deploy": "nuxi build --preset cloudflare-pages && wrangler pages deploy dist && npx wrangler d1 migrations apply apay --remote",
    "migrate": "drizzle-kit push",
    "db:pg:gen": "drizzle-kit generate --config=drizzle.pg.config.ts",
    "db:pg:push": "drizzle-kit push --config=drizzle.pg.config.ts",
    "db:pg:migrate": "drizzle-kit migrate --config=drizzle.pg.config.ts",
    "db:qingpu:init": "node --env-file-if-exists=.env app/themes/qingpu/scripts/apply-qingpu-sql.mjs",
    "db:gen": "drizzle-kit generate --config=drizzle.config.ts",
    "db:push": "drizzle-kit push --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:mysql:gen": "drizzle-kit generate --config=drizzle.mysql.config.ts",
    "db:mysql:push": "drizzle-kit push --config=drizzle.mysql.config.ts",
    "db:mysql:migrate": "drizzle-kit migrate --config=drizzle.mysql.config.ts",
    "verify:qingpu-support": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/verify-qingpu-support.mjs",
    "ai:check": "node scripts/ai-task-flow.mjs check",
    "ai:prepare": "node scripts/ai-task-flow.mjs prepare",
    "ai:complete": "node scripts/ai-task-flow.mjs complete",
    "ai:status": "node scripts/ai-task.mjs status",
    "ai:selftest": "node scripts/ai-task.selftest.mjs",
    "ai:demo:prepare": "node scripts/ai-task-flow.mjs prepare --contract .ai/tasks/hello-ai-task.demo.json --agent demo-ai",
    "ai:demo:complete": "node scripts/ai-task-flow.mjs complete --contract .ai/tasks/hello-ai-task.demo.json --agent demo-ai",
    "check:qingpu-listing-publish-facts": "node app/themes/qingpu/scripts/check-listing-publish-facts.mjs",
    "check:qingpu-employee-access-gate": "node app/themes/qingpu/scripts/check-employee-access-gate.mjs",
    "check:qingpu-quota-gate": "node app/themes/qingpu/scripts/check-quota-gate.mjs",
    "check:qingpu-table-ownership": "node app/themes/qingpu/scripts/check-table-ownership.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@libsql/client": "^0.17.2",
    "@nuxt/content": "^3.15.2",
    "@nuxt/icon": "^2.2.1",
    "@nuxt/ui": "^4.6.1",
    "@tiptap/extension-image": "^3.30.1",
    "@tiptap/extension-link": "^3.30.1",
    "@tiptap/extension-list": "^3.30.1",
    "@tiptap/extension-ordered-list": "^3.30.1",
    "@tiptap/pm": "^3.30.1",
    "@tiptap/vue-3": "^3.30.1",
    "@vueuse/integrations": "^14.2.1",
    "@vueuse/motion": "^3.0.3",
    "crypto-js": "^4.2.0",
    "drizzle-orm": "^0.45.2",
    "maxmind": "^5.0.6",
    "mysql2": "^3.22.3",
    "nuxt": "^4.4.2",
    "nuxt-auth-utils": "^0.5.29",
    "pg": "^8.20.0",
    "postgres": "^3.4.9",
    "sortablejs": "^1.15.7",
    "vuedraggable": "^4.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@iconify-json/ph": "^1.2.2",
    "@nuxthub/core": "^0.10.7",
    "@nuxtjs/i18n": "^9.0.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.2",
    "@types/crypto-js": "^4.2.2",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.2.6",
    "wrangler": "^4.78.0"
  }
}
