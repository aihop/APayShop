{
  "schemaVersion": 1,
  "id": "qingpu-hero-unreferenced-props-guard",
  "title": "禁止 Hero 图片新增无参考装饰道具",
  "problem": "商品主图生成会在参考图没有装饰物时新增花瓶、花朵等场景道具，削弱主图保真度。",
  "expectedOutcome": "商品主图和 SKU 主图明确禁止新增参考图中不存在的装饰道具，图集场景图仍按槽位目标使用环境元素。",
  "constraints": [
    "只修改 qingpu-ai 共享 Hero 提示词及相关测试",
    "不把禁令扩散到 gallery_image 场景图",
    "不提交、不推送、不发布 engine vendor"
  ],
  "repositories": [
    {
      "name": "qingpu-ai",
      "path": "../qingpu-ai",
      "allowedPaths": [
        "src/prompts/hero_visual_consistency.ts",
        "tests/asset-prompt-contracts.test.ts"
      ],
      "claims": [
        "src/prompts/hero_visual_consistency.ts",
        "tests/asset-prompt-contracts.test.ts"
      ]
    }
  ],
  "acceptanceCriteria": [
    "main_image 最终执行提示词禁止新增参考图未出现的装饰道具",
    "sku_image 最终执行提示词应用同一禁令",
    "gallery_image 最终执行提示词不包含 Hero 道具禁令"
  ],
  "verification": [
    {
      "name": "Hero 提示词契约测试",
      "repository": "qingpu-ai",
      "always": true,
      "command": "npx vitest run tests/asset-prompt-contracts.test.ts"
    },
    {
      "name": "精确格式检查",
      "repository": "qingpu-ai",
      "always": true,
      "command": "git diff --check"
    }
  ]
}
